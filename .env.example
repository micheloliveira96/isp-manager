# App
APP_NAME="ISP Manager"
APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL: local Docker service name is db; for local npm dev use localhost.
DATABASE_URL="postgresql://isp_app:change-this-password@db:5432/isp_manager?schema=public"
POSTGRES_DB=isp_manager
POSTGRES_USER=isp_app
POSTGRES_PASSWORD=change-this-password

# Generate a random secret of at least 32 characters.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="change-this-immediately"
