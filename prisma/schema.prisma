generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  status      String            @default("active")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  users       User[]
  orders      ServiceOrder[]
  teams       ServiceTeam[]
  technicians Technician[]
  serviceTypes ServiceType[]
  branding    BrandingSettings?
  auditEvents AuditEvent[]
  inventoryProducts InventoryProduct[]
  inventoryAssignments InventoryAssignment[]
  fleetVehicles FleetVehicle[]
  fuelRefills FuelRefill[]
  clients Client[]
  internetPlans InternetPlan[]
  invoices BillingInvoice[]
  payments Payment[]
  attendanceRecords AttendanceRecord[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  passwordHash   String
  mustChangePassword Boolean @default(false)
  role           String       @default("ATTENDANT")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditEvents    AuditEvent[]
  attendanceRecords AttendanceRecord[]
  permissions    UserPermission[]
  @@unique([organizationId, email])
  @@index([organizationId, role])
}

model BrandingSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  systemName     String       @default("ISP Manager")
  logoUrl        String?
  primaryColor   String       @default("#4863ed")
  accentColor    String       @default("#22a77d")
  welcomeTitle   String       @default("Gestão operacional")
  welcomeMessage String       @default("Acompanhe a operação da sua equipa.")
  supportEmail   String?
  supportPhone   String?
  updatedAt      DateTime     @updatedAt
}

model ServiceOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  title          String
  customerName   String
  phone          String?
  pppoeUsername  String?
  pppoePassword  String?
  address        String?
  description    String?
  priority       String       @default("NORMAL")
  status         String       @default("OPEN")
  assignedTeam   String?
  technology     String?
  ponPort        String?
  scheduledAt    DateTime?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([organizationId, code])
  @@index([organizationId, status, createdAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actor          User?        @relation(fields: [actorUserId], references: [id])
  action         String
  entityType     String
  entityId       String?
  details        Json?
  createdAt      DateTime     @default(now())
  @@index([organizationId, createdAt])
}

model UserPermission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionCode String
  allowed        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([userId, permissionCode])
  @@index([userId])
}

model ServiceTeam {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  technicians    Technician[]
  @@unique([organizationId, name])
  @@index([organizationId, active])
  inventoryAssignments InventoryAssignment[]
}

model Technician {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String?
  team           ServiceTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name           String
  address        String?
  phone          String?
  email          String?
  notes          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId, active])
  @@index([teamId])
  inventoryAssignments InventoryAssignment[]
  drivenVehicles FleetVehicle[] @relation("FleetDriver")
  fuelRefills FuelRefill[]
}

model ServiceType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([organizationId, name])
  @@index([organizationId, active])
}


model InventoryProduct {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String   @default("OTHER")
  sku            String?
  unit           String   @default("UN")
  quantityOnHand Int      @default(0)
  minQuantity    Int      @default(0)
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignments    InventoryAssignment[]
  @@unique([organizationId, sku])
  @@index([organizationId, category, active])
}

model InventoryAssignment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  technicianId   String?
  technician     Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  teamId         String?
  team           ServiceTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status         String   @default("ASSIGNED")
  assignedAt     DateTime @default(now())
  returnedAt     DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId, status])
  @@index([productId, status])
  @@index([technicianId, status])
  @@index([teamId, status])
  @@index([vehicleId, status])
}

model FleetVehicle {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plate             String
  brand             String?
  model             String
  year              Int?
  driverTechnicianId String?
  driver             Technician? @relation("FleetDriver", fields: [driverTechnicianId], references: [id], onDelete: SetNull)
  ipvaDueDate       DateTime?
  tireStatus        String   @default("UNKNOWN")
  lastOilChangeDate DateTime?
  lastOilChangeKm   Int?
  odometerKm        Int?
  status            String   @default("ACTIVE")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  inventoryAssignments InventoryAssignment[]
  fuelRefills FuelRefill[]
  @@unique([organizationId, plate])
  @@index([organizationId, status])
  @@index([driverTechnicianId])
}


model Client {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  name           String
  taxNumber      String?
  address        String?
  postalCode     String?
  locality       String?
  phone          String
  alternatePhone String?
  email          String?
  planId         String?
  plan           InternetPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  monthlyPrice   Decimal  @db.Decimal(10, 2)
  installDate    DateTime?
  dueDay         Int      @default(10)
  status         String   @default("ACTIVE")
  notes          String?
  invoices       BillingInvoice[]
  payments       Payment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, number])
  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, status])
}

model InternetPlan {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  downloadMbps   Int
  uploadMbps     Int
  monthlyPrice   Decimal  @db.Decimal(10, 2)
  description    String?
  active         Boolean  @default(true)
  clients        Client[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model BillingInvoice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  period         String
  amount         Decimal  @db.Decimal(10, 2)
  dueDate        DateTime
  status         String   @default("PENDING")
  paidAt         DateTime?
  payments       Payment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([clientId, period])
  @@index([organizationId, status, dueDate])
  @@index([clientId, dueDate])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount         Decimal  @db.Decimal(10, 2)
  method         String
  reference      String?
  paidAt         DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())
  @@index([organizationId, paidAt])
  @@index([clientId, paidAt])
}


model AttendanceRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType      String
  occurredAt     DateTime     @default(now())
  photoData      String?      @db.Text
  latitude       Float?
  longitude      Float?
  notes          String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  @@index([organizationId, userId, occurredAt])
  @@index([organizationId, eventType, occurredAt])
}


model FuelRefill {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  technicianId   String?
  technician     Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  refilledAt     DateTime @default(now())
  odometerKm     Int
  liters         Decimal? @db.Decimal(10, 2)
  totalCost      Decimal  @db.Decimal(10, 2)
  pricePerLiter  Decimal? @db.Decimal(10, 3)
  station        String?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  @@index([organizationId, refilledAt])
  @@index([vehicleId, refilledAt])
}
